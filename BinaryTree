                current = current.right;
            }

            KeyValuePair<K, D> pair = new KeyValuePair<K, D>(current.Key, current.Data);
            if (parent == null)
            {
                root = current.left;
            }
            else
            {
                parent.right = current.left;
            }

            Size--;
            current.right = null;
            current.left = null;
            return pair;
        }
