        //26
        public KeyValuePair<K, D> pollFirstEntry()
        {
            if (root == null)
            {
                return default(KeyValuePair<K, D>);
            }

            Node parent = null;
            Node current = root;
            while (current.left != null)
            {
                parent = current;
                current = current.left;

            }
            KeyValuePair<K, D> pair = new KeyValuePair<K, D>(current.Key, current.Data);
            if (parent == null)
            {
                root = current.right;
            }
            else
            {
                parent.left = current.right;
            }

            current.right = null;
            current.left = null;
            Size--;
            return pair;
        }

