using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace BinaryTree
{
    public class BinaryTreeSearch<K, D> where K : IComparable<K>
    {
        private int Size;
        private Node root;
        private readonly IComparer<K> comparator;
        //1
        public BinaryTreeSearch() : this(Comparer<K>.Default)
        {

        }
        //2
        public BinaryTreeSearch(IComparer<K> comparator)//2 пункт
        {
            this.comparator = comparator;

            root = null;
        }
        private class Node
        {
            public D Data;
            public K Key;
            public Node left;
            public Node right;
            public Node(K key, D data)
            {
                this.Key = key;
                this.Data = data;
                left = null; right = null;
            }
        }

        //10 добавление
        public void Put(K k, D data)//добавление
        {
            Node current = new Node(k, data);
            if (root == null)
            {
                root = current;
                Size++;
                return;
            }
            else
            {
                bool add = AddRec(root, current);
                if (add) Size++;
            }

        }
        private bool AddRec(Node current, Node newNode)
        {
            int compresult = comparator.Compare(newNode.Key, current.Key);
            if (compresult < 0)
            {
                if (current.left == null)
                {
                    current.left = newNode;
                    return true;
                }
                else
                {
                    return AddRec(current.left, newNode);
                }
            }
            else if (compresult > 0)
            {
                if (current.right == null)
                {
                    current.right = newNode;
                    return true;
                }
                else
                {
                    return AddRec(current.right, newNode);
                }
            }
            else
            {
                current.Data = newNode.Data;
                return false;
            }
        }
        //11 удаление
        public void Remove(K key)//удаление
        {
            bool removed;
            root = RemoveRec(root, key, out removed);
            if (removed) Size--;

        }
        private Node RemoveRec(Node current, K key, out bool removed)
        {
            if (current == null)
            {
                removed = false;
                return null;
            }
            int compres = comparator.Compare(key, current.Key);
            if (compres < 0)
            {
                current.left = RemoveRec(current.left, key, out removed);
                return current;
            }
            else if (compres > 0)
            {
                current.right = RemoveRec(current.right, key, out removed);
                return current;
            }
            else
            {
                removed = true;
                if (current.right == null && current.left == null)
                {
                    current = null;
                    return null;
                }
                else if (current.right == null && current.left != null)
                {
                    return current.left;
                }
                else if (current.right != null && current.left == null)
                {
                    return current.right;
                }
                else
                {

                    Node min = FindMin(current.right);
                    current.Key = min.Key;
                    current.Data = min.Data;

                    bool d;
                    current.right = RemoveRec(current.right, min.Key, out d);
                    return current;

                }
            }


        }
        private Node FindMin(Node node)
        {
            while (node.left != null)
                node = node.left;
            return node;
        }
        //3
        public void Clear()
        {
            root = null;
            Size = 0;
        }
        //4
        public bool ContainsKey(K key)
        {
            Node current = root;

            while (current != null)
            {
                int comp = comparator.Compare(key, current.Key);
                if (comp < 0) current = current.left;
                else if (comp > 0) current = current.right;
                else
                {
                    return true;
                }
            }
            return false;

        }
        //5
        public bool ContainsValue(D value)
        {
            bool found;
            ContainsValueRec(root, value, out found);
            return found;
        }

        private void ContainsValueRec(Node node, D value, out bool found)
        {
            if (node == null)
            {
                found = false;
                return;
            }

            if (EqualityComparer<D>.Default.Equals(node.Data, value))
            {
                found = true;
                return;
            }

            bool leftFound;
            ContainsValueRec(node.left, value, out leftFound);
            if (leftFound)
            {
                found = true;
                return;
            }

            bool rightFound;
            ContainsValueRec(node.right, value, out rightFound);
            found = rightFound;
        }
        //6
        public List<KeyValuePair<K, D>> EntrySet()
        {
            var list = new List<KeyValuePair<K, D>>();
            AddList(root, list);
            return list;
        }

        private void AddList(Node node, List<KeyValuePair<K, D>> list)
        {
            if (node == null) return;

            AddList(node.left, list);
            list.Add(new KeyValuePair<K, D>(node.Key, node.Data));
            AddList(node.right, list);
        }
        //7
        public D Get(K key)
        {
            D data = getValue(root, key);
            return data;
        }
        private D getValue(Node node, K key)
        {
            Node current = node;
            if (current == null)
            {
                return default;
            }
            int comp = comparator.Compare(key, current.Key);
            if (comp < 0)
            {
                current = current.left;
                return getValue(current, key);
            }
            else if (comp > 0)
            {
                current = current.right;
                return getValue(current, key);
            }
            else
            {
                return current.Data;
            }
        }
        //8
        public bool IsEmpty()
        {
            if (Size == 0) return true;
            return false;
        }
        //12
        public int size()
        {

            return Size;
        }
        //9
        public List<K> KeySet()
        {
            List<K> Set = new List<K>();
            AddKeySet(root,Set);
            return Set;
        }
        private void AddKeySet(Node node,List<K> set)
        {
            if (node == null) return;
            AddKeySet(node.left,set);
            set.Add(node.Key);
            AddKeySet(node.right, set);
        }
        //13
        public K firstKey()
        {
            Node current = root;
            if (current == null) throw new InvalidOperationException();
            while (current.left != null)
            {
                current = current.left;

            }
            return current.Key;
        }
        //14
        public K lastKey()
        {
            Node current = root;
            if (current == null) throw new InvalidOperationException();
            while (current.right != null)
            {
                current = current.right;

            }
            return current.Key;
        }
        //15
        public BinaryTreeSearch<K,D> headMap(K end)
        {

            BinaryTreeSearch<K, D> newTree = new BinaryTreeSearch<K, D>();
            AddHeapMap(root, newTree, end);
            return newTree;
        }
        private void AddHeapMap(Node node ,BinaryTreeSearch<K,D> tree, K end)
        {
            if (node == null) return;
            int comp = comparator.Compare(end, node.Key);
            AddHeapMap(node.left, tree, end);
            if (comp < 0)
            {
                tree.Put(node.Key, node.Data);
                AddHeapMap(node.right, tree, end);
            }

        }
        //16
        public BinaryTreeSearch<K, D> SubMap(K start,K end)
        {
            if(start==null || end == null)
            {
                throw new InvalidOperationException();
            }
            int comp = comparator.Compare(start, end);
            if (comp > 0)
            {
                throw new InvalidOperationException();
            }
            
            BinaryTreeSearch<K, D> newTree = new BinaryTreeSearch<K, D>();
            AddSubMap(root, newTree,start, end);
            return newTree;

        }
        private void AddSubMap(Node node,BinaryTreeSearch<K,D> tree ,K start,K end)
        {
            if (node == null) return;
            int comp = comparator.Compare(node.Key, start);
            int comp2 = comparator.Compare(node.Key,end);
           
            if (comp > 0)
            {
                AddSubMap(node.left, tree, start, end);
            }
            if((comp>=0 ) && comp2 < 0)
            {
                tree.Put(node.Key, node.Data);
                
            }
            if (comp2 < 0)
            {
                AddSubMap(node.right, tree, start, end);
            }
          
        }
        //17
        public BinaryTreeSearch<K, D> tailMap(K start)
        {

            BinaryTreeSearch<K, D> newTree = new BinaryTreeSearch<K, D>();
            AddtailMap(root, newTree, start);
            return newTree;
        }
        private void AddtailMap(Node node, BinaryTreeSearch<K, D> tree, K start)
        {
            if (node == null) return;
            int comp = comparator.Compare(start, node.Key);
            AddHeapMap(node.right, tree, start);
            if (comp > 0)
            {
                tree.Put(node.Key, node.Data);
                AddHeapMap(node.left, tree, start);
            }
           
        }
        //18
        public KeyValuePair<K,D> lowerEntry(K key)
        {
            KeyValuePair<K, D> pair = new KeyValuePair<K, D>();

        }
        public void FindlowerEntry(Node node,K key,KeyValuePair<K,D> pair)
        {
            if (node == null) return;
            int comp = comparator.Compare(key, node.Key);
            FindlowerEntry(node.left, key,pair);
            if (comp < 0)
            {
                pair.Key = node.Key;
                
            }
            FindlowerEntry(node.right, key, pair);
        }
       
    }

