        private void AddKeySet(Node node, List<K> set)
        {
            if (node == null) return;
            AddKeySet(node.left, set);
            set.Add(node.Key);
            AddKeySet(node.right, set);
        }

        //13
        public K firstKey()
        {

            if (root == null) throw new InvalidOperationException();
            Node current = root;
            while (current.left != null)
            {
                current = current.left;

            }

            return current.Key;
        }

        //14
        public K lastKey()
        {

            if (root == null) throw new InvalidOperationException();
            Node current = root;
            while (current.right != null)
