using System;
using System.Collections.Generic;

namespace Tree
{
    public enum NodeColor
    {
        Red,
        Black
    }

    public delegate int TreeMapComparator<T>(T a, T b);

    public class MyTreeMap<K, V> where K : IComparable<K>
    {
        private int size;
        private Node root;
        private readonly IComparer<K> comparer;

        public int Size
        {
            get { return size; }
        }

        public sealed class Node
        {
            public Node Left;
            public Node Right;
            public Node Parent;
            public K Key;
            public V Value;
            public NodeColor Color;

            public static readonly Node NIL = new Node();

            private Node()
            {
                Left = this;
                Right = this;
                Parent = this;
                Color = NodeColor.Black;
            }

            public Node(K key, V value)
            {
                Key = key;
                Value = value;
                Left = NIL;
                Right = NIL;
                Parent = NIL;
                Color = NodeColor.Red;
            }
        }

        public MyTreeMap()
        {
            comparer = Comparer<K>.Default;
            root = Node.NIL;
            size = 0;
        }

        public MyTreeMap(IComparer<K> comparer)
        {
            if (comparer == null)
            {
                this.comparer = Comparer<K>.Default;
            }
            else
            {
                this.comparer = comparer;
            }

            root = Node.NIL;
            size = 0;
        }

        public MyTreeMap(TreeMapComparator<K> comparator)
        {
            if (comparator == null)
            {
                comparer = Comparer<K>.Default;
            }
            else
            {
                comparer = Comparer<K>.Create((a, b) => comparator(a, b));
            }

            root = Node.NIL;
            size = 0;
        }

        public int CompareKeys(K a, K b)
        {
            return comparer.Compare(a, b);
        }

        private void RotateLeft(Node current)
        {
            Node newRoot = current.Right;
            current.Right = newRoot.Left;

            if (newRoot.Left != Node.NIL)
            {
                newRoot.Left.Parent = current;
            }

            newRoot.Parent = current.Parent;

            if (current.Parent == Node.NIL)
            {
                root = newRoot;
            }
            else if (current == current.Parent.Left)
            {
                current.Parent.Left = newRoot;
            }
            else
            {
                current.Parent.Right = newRoot;
            }

            newRoot.Left = current;
            current.Parent = newRoot;
        }

        private void RotateRight(Node current)
        {
            Node newRoot = current.Left;
            current.Left = newRoot.Right;

            if (newRoot.Right != Node.NIL)
            {
                newRoot.Right.Parent = current;
            }

            newRoot.Parent = current.Parent;

            if (current.Parent == Node.NIL)
            {
                root = newRoot;
            }
            else if (current == current.Parent.Right)
            {
                current.Parent.Right = newRoot;
            }
            else
            {
                current.Parent.Left = newRoot;
            }

            newRoot.Right = current;
            current.Parent = newRoot;
        }

        private void FixAfterInsert(Node current)
        {
            while (current.Parent.Color == NodeColor.Red)
            {
                if (current.Parent == current.Parent.Parent.Left)
                {
                    Node uncle = current.Parent.Parent.Right;

                    if (uncle.Color == NodeColor.Red)
                    {
                        current.Parent.Color = NodeColor.Black;
                        uncle.Color = NodeColor.Black;
                        current.Parent.Parent.Color = NodeColor.Red;
                        current = current.Parent.Parent;
                    }
                    else
                    {
                        if (current == current.Parent.Right)
                        {
                            current = current.Parent;
                            RotateLeft(current);
                        }

                        current.Parent.Color = NodeColor.Black;
                        current.Parent.Parent.Color = NodeColor.Red;
                        RotateRight(current.Parent.Parent);
                    }
                }
                else
                {
                    Node uncle = current.Parent.Parent.Left;

                    if (uncle.Color == NodeColor.Red)
                    {
                        current.Parent.Color = NodeColor.Black;
                        uncle.Color = NodeColor.Black;
                        current.Parent.Parent.Color = NodeColor.Red;
                        current = current.Parent.Parent;
                    }
                    else
                    {
                        if (current == current.Parent.Left)
                        {
                            current = current.Parent;
                            RotateRight(current);
                        }

                        current.Parent.Color = NodeColor.Black;
                        current.Parent.Parent.Color = NodeColor.Red;
                        RotateLeft(current.Parent.Parent);
                    }
                }
            }

            root.Color = NodeColor.Black;
        }

        private Node FindNode(K key)
        {
            Node current = root;

            while (current != Node.NIL)
            {
                int cmp = comparer.Compare(key, current.Key);

                if (cmp < 0)
                {
                    current = current.Left;
                }
                else if (cmp > 0)
                {
                    current = current.Right;
                }
                else
                {
                    return current;
                }
            }

            return Node.NIL;
        }

        private Node Minimum(Node current)
        {
            while (current != Node.NIL && current.Left != Node.NIL)
            {
                current = current.Left;
            }

            return current;
        }

        private Node Maximum(Node current)
        {
            while (current != Node.NIL && current.Right != Node.NIL)
            {
                current = current.Right;
            }

            return current;
        }

        private void Transplant(Node oldNode, Node newNode)
        {
            if (oldNode.Parent == Node.NIL)
            {
                root = newNode;
            }
            else if (oldNode == oldNode.Parent.Left)
            {
                oldNode.Parent.Left = newNode;
            }
            else
            {
                oldNode.Parent.Right = newNode;
            }

            newNode.Parent = oldNode.Parent;
        }

        private void FixAfterDelete(Node current)
        {
            while (current != root && current.Color == NodeColor.Black)
            {
                if (current == current.Parent.Left)
                {
                    Node brother = current.Parent.Right;

                    if (brother.Color == NodeColor.Red)
                    {
                        brother.Color = NodeColor.Black;
                        current.Parent.Color = NodeColor.Red;
                        RotateLeft(current.Parent);
                        brother = current.Parent.Right;
                    }

                    if (brother.Left.Color == NodeColor.Black && brother.Right.Color == NodeColor.Black)
                    {
                        brother.Color = NodeColor.Red;
                        current = current.Parent;
                    }
                    else
                    {
                        if (brother.Right.Color == NodeColor.Black)
                        {
                            brother.Left.Color = NodeColor.Black;
                            brother.Color = NodeColor.Red;
                            RotateRight(brother);
                            brother = current.Parent.Right;
                        }

                        brother.Color = current.Parent.Color;
                        current.Parent.Color = NodeColor.Black;
                        brother.Right.Color = NodeColor.Black;
                        RotateLeft(current.Parent);
                        current = root;
                    }
                }
                else
                {
                    Node brother = current.Parent.Left;

                    if (brother.Color == NodeColor.Red)
                    {
                        brother.Color = NodeColor.Black;
                        current.Parent.Color = NodeColor.Red;
                        RotateRight(current.Parent);
                        brother = current.Parent.Left;
                    }

                    if (brother.Right.Color == NodeColor.Black && brother.Left.Color == NodeColor.Black)
                    {
                        brother.Color = NodeColor.Red;
                        current = current.Parent;
                    }
                    else
                    {
                        if (brother.Left.Color == NodeColor.Black)
                        {
                            brother.Right.Color = NodeColor.Black;
                            brother.Color = NodeColor.Red;
                            RotateLeft(brother);
                            brother = current.Parent.Left;
                        }

                        brother.Color = current.Parent.Color;
                        current.Parent.Color = NodeColor.Black;
                        brother.Left.Color = NodeColor.Black;
                        RotateRight(current.Parent);
                        current = root;
                    }
                }
            }

            current.Color = NodeColor.Black;
        }

        public bool Put(K key, V value)
        {
            Node newNode = new Node(key, value);
            Node parent = Node.NIL;
            Node current = root;

            while (current != Node.NIL)
            {
                parent = current;
                int cmp = comparer.Compare(key, current.Key);

                if (cmp < 0)
                {
                    current = current.Left;
                }
                else if (cmp > 0)
                {
                    current = current.Right;
                }
                else
                {
                    current.Value = value;
                    return false;
                }
            }

            newNode.Parent = parent;

            if (parent == Node.NIL)
            {
                root = newNode;
            }
            else if (comparer.Compare(key, parent.Key) < 0)
            {
                parent.Left = newNode;
            }
            else
            {
                parent.Right = newNode;
            }

            size++;
            FixAfterInsert(newNode);
            root.Color = NodeColor.Black;

            return true;
        }

        public bool Remove(K key)
        {
            Node deletedNode = FindNode(key);

            if (deletedNode == Node.NIL)
            {
                return false;
            }

            Node changedNode = deletedNode;
            NodeColor oldColor = changedNode.Color;
            Node current;

            if (deletedNode.Left == Node.NIL)
            {
                current = deletedNode.Right;
                Transplant(deletedNode, deletedNode.Right);
            }
            else if (deletedNode.Right == Node.NIL)
            {
                current = deletedNode.Left;
                Transplant(deletedNode, deletedNode.Left);
            }
            else
            {
                changedNode = Minimum(deletedNode.Right);
                oldColor = changedNode.Color;
                current = changedNode.Right;

                if (changedNode.Parent == deletedNode)
                {
                    current.Parent = changedNode;
                }
                else
                {
                    Transplant(changedNode, changedNode.Right);
                    changedNode.Right = deletedNode.Right;
                    changedNode.Right.Parent = changedNode;
                }

                Transplant(deletedNode, changedNode);
                changedNode.Left = deletedNode.Left;
                changedNode.Left.Parent = changedNode;
                changedNode.Color = deletedNode.Color;
            }

            size--;

            if (oldColor == NodeColor.Black)
            {
                FixAfterDelete(current);
            }

            if (root != Node.NIL)
            {
                root.Color = NodeColor.Black;
            }

            return true;
        }

        public bool ContainsKey(K key)
        {
            return FindNode(key) != Node.NIL;
        }

        public void Clear()
        {
            root = Node.NIL;
            size = 0;
        }

        public bool IsEmpty()
        {
            return size == 0;
        }

        public bool TryGetFirstKey(out K key)
        {
            if (root == Node.NIL)
            {
                key = default(K);
                return false;
            }

            key = Minimum(root).Key;
            return true;
        }

        public bool TryGetLastKey(out K key)
        {
            if (root == Node.NIL)
            {
                key = default(K);
                return false;
            }

            key = Maximum(root).Key;
            return true;
        }

        public bool TryGetCeilingKey(K key, out K result)
        {
            Node current = root;
            Node answer = Node.NIL;

            while (current != Node.NIL)
            {
                int cmp = comparer.Compare(key, current.Key);

                if (cmp == 0)
                {
                    result = current.Key;
                    return true;
                }

                if (cmp < 0)
                {
                    answer = current;
                    current = current.Left;
                }
                else
                {
                    current = current.Right;
                }
            }

            if (answer == Node.NIL)
            {
                result = default(K);
                return false;
            }

            result = answer.Key;
            return true;
        }

        public bool TryGetFloorKey(K key, out K result)
        {
            Node current = root;
            Node answer = Node.NIL;

            while (current != Node.NIL)
            {
                int cmp = comparer.Compare(key, current.Key);

                if (cmp == 0)
                {
                    result = current.Key;
                    return true;
                }

                if (cmp < 0)
                {
                    current = current.Left;
                }
                else
                {
                    answer = current;
                    current = current.Right;
                }
            }

            if (answer == Node.NIL)
            {
                result = default(K);
                return false;
            }

            result = answer.Key;
            return true;
        }

        public bool TryGetHigherKey(K key, out K result)
        {
            Node current = root;
            Node answer = Node.NIL;

            while (current != Node.NIL)
            {
                int cmp = comparer.Compare(key, current.Key);

                if (cmp < 0)
                {
                    answer = current;
                    current = current.Left;
                }
                else
                {
                    current = current.Right;
                }
            }

            if (answer == Node.NIL)
            {
                result = default(K);
                return false;
            }

            result = answer.Key;
            return true;
        }

        public bool TryGetLowerKey(K key, out K result)
        {
            Node current = root;
            Node answer = Node.NIL;

            while (current != Node.NIL)
            {
                int cmp = comparer.Compare(key, current.Key);

                if (cmp <= 0)
                {
                    current = current.Left;
                }
                else
                {
                    answer = current;
                    current = current.Right;
                }
            }

            if (answer == Node.NIL)
            {
                result = default(K);
                return false;
            }

            result = answer.Key;
            return true;
        }

        private void FillAscending(Node current, List<K> list)
        {
            if (current == Node.NIL)
            {
                return;
            }

            FillAscending(current.Left, list);
            list.Add(current.Key);
            FillAscending(current.Right, list);
        }

        private void FillDescending(Node current, List<K> list)
        {
            if (current == Node.NIL)
            {
                return;
            }

            FillDescending(current.Right, list);
            list.Add(current.Key);
            FillDescending(current.Left, list);
        }

        public List<K> KeysAscending()
        {
            List<K> list = new List<K>();
            FillAscending(root, list);
            return list;
        }

        public List<K> KeysDescending()
        {
            List<K> list = new List<K>();
            FillDescending(root, list);
            return list;
        }
    }

    public class MyTreeSet<E> where E : IComparable<E>
    {
        private static readonly object PRESENT = new object();
        private MyTreeMap<E, object> m;

        private bool hasLowerBound;
        private E lowerBound;
        private bool lowerInclusive;

        private bool hasUpperBound;
        private E upperBound;
        private bool upperInclusive;

        private bool descending;

        private MyTreeSet(MyTreeMap<E, object> map,bool hasLowerBound,E lowerBound,bool lowerInclusive,bool hasUpperBound,E upperBound,bool upperInclusive,bool descending)
        {
            m = map;

            this.hasLowerBound = hasLowerBound;
            this.lowerBound = lowerBound;
            this.lowerInclusive = lowerInclusive;

            this.hasUpperBound = hasUpperBound;
            this.upperBound = upperBound;
            this.upperInclusive = upperInclusive;

            this.descending = descending;
        }

        private void CheckNull(E value)
        {
            if (object.ReferenceEquals(value, null))
            {
                throw new ArgumentNullException("value");
            }
        }

        private bool InRange(E value)
        {
            if (hasLowerBound)
            {
                int cmp = m.CompareKeys(value, lowerBound);

                if (cmp < 0)
                {
                    return false;
                }

                if (cmp == 0 && !lowerInclusive)
                {
                    return false;
                }
            }

            if (hasUpperBound)
            {
                int cmp = m.CompareKeys(value, upperBound);

                if (cmp > 0)
                {
                    return false;
                }

                if (cmp == 0 && !upperInclusive)
                {
                    return false;
                }
            }

            return true;
        }

        private void CheckRangeForAdd(E value)
        {
            if (!InRange(value))
            {
                throw new ArgumentOutOfRangeException("Элемент выходит за границы текущего представления множества");
            }
        }

        private IEnumerable<E> EnumerateVisibleAscending()
        {
            List<E> list = m.KeysAscending();

            for (int i = 0; i < list.Count; i++)
            {
                if (InRange(list[i]))
                {
                    yield return list[i];
                }
            }
        }

        private IEnumerable<E> EnumerateVisibleDescending()
        {
            List<E> list = m.KeysDescending();

            for (int i = 0; i < list.Count; i++)
            {
                if (InRange(list[i]))
                {
                    yield return list[i];
                }
            }
        }

        private IEnumerable<E> EnumerateVisible()
        {
            if (descending)
            {
                return EnumerateVisibleDescending();
            }

            return EnumerateVisibleAscending();
        }

        private bool ContainsInArray(E value, E[] array)
        {
            for (int i = 0; i < array.Length; i++)
            {
                if (m.CompareKeys(value, array[i]) == 0)
                {
                    return true;
                }
            }

            return false;
        }

        private bool TryGetFirstVisible(out E value)
        {
            bool ok;

            if (!descending)
            {
                if (hasLowerBound)
                {
                    if (lowerInclusive)
                    {
                        ok = m.TryGetCeilingKey(lowerBound, out value);
                    }
                    else
                    {
                        ok = m.TryGetHigherKey(lowerBound, out value);
                    }
                }
                else
                {
                    ok = m.TryGetFirstKey(out value);
                }
            }
            else
            {
                if (hasUpperBound)
                {
                    if (upperInclusive)
                    {
                        ok = m.TryGetFloorKey(upperBound, out value);
                    }
                    else
                    {
                        ok = m.TryGetLowerKey(upperBound, out value);
                    }
                }
                else
                {
                    ok = m.TryGetLastKey(out value);
                }
            }

            if (!ok)
            {
                value = default(E);
                return false;
            }

            if (!InRange(value))
            {
                value = default(E);
                return false;
            }

            return true;
        }

        private bool TryGetLastVisible(out E value)
        {
            bool ok;

            if (!descending)
            {
                if (hasUpperBound)
                {
                    if (upperInclusive)
                    {
                        ok = m.TryGetFloorKey(upperBound, out value);
                    }
                    else
                    {
                        ok = m.TryGetLowerKey(upperBound, out value);
                    }
                }
                else
                {
                    ok = m.TryGetLastKey(out value);
                }
            }
            else
            {
                if (hasLowerBound)
                {
                    if (lowerInclusive)
                    {
                        ok = m.TryGetCeilingKey(lowerBound, out value);
                    }
                    else
                    {
                        ok = m.TryGetHigherKey(lowerBound, out value);
                    }
                }
                else
                {
                    ok = m.TryGetFirstKey(out value);
                }
            }

            if (!ok)
            {
                value = default(E);
                return false;
            }

            if (!InRange(value))
            {
                value = default(E);
                return false;
            }

            return true;
        }

        private MyTreeSet<E> CreateView(bool addLower,E newLower,bool newLowerInclusive,bool addUpper,E newUpper,bool newUpperInclusive,bool newDescending)
        {
            bool finalHasLower = hasLowerBound;
            E finalLower = lowerBound;
            bool finalLowerInclusive = lowerInclusive;

            bool finalHasUpper = hasUpperBound;
            E finalUpper = upperBound;
            bool finalUpperInclusive = upperInclusive;

            if (addLower)
            {
                if (!finalHasLower)
                {
                    finalHasLower = true;
                    finalLower = newLower;
                    finalLowerInclusive = newLowerInclusive;
                }
                else
                {
                    int cmp = m.CompareKeys(newLower, finalLower);

                    if (cmp > 0)
                    {
                        finalLower = newLower;
                        finalLowerInclusive = newLowerInclusive;
                    }
                    else if (cmp == 0)
                    {
                        finalLowerInclusive = finalLowerInclusive && newLowerInclusive;
                    }
                }
            }

            if (addUpper)
            {
                if (!finalHasUpper)
                {
                    finalHasUpper = true;
                    finalUpper = newUpper;
                    finalUpperInclusive = newUpperInclusive;
                }
                else
                {
                    int cmp = m.CompareKeys(newUpper, finalUpper);

                    if (cmp < 0)
                    {
                        finalUpper = newUpper;
                        finalUpperInclusive = newUpperInclusive;
                    }
                    else if (cmp == 0)
                    {
                        finalUpperInclusive = finalUpperInclusive && newUpperInclusive;
                    }
                }
            }

            if (finalHasLower && finalHasUpper)
            {
                int cmp = m.CompareKeys(finalLower, finalUpper);

                if (cmp > 0)
                {
                    throw new ArgumentException("Нижняя граница больше верхней");
                }
            }

            return new MyTreeSet<E>(m,finalHasLower,finalLower,finalLowerInclusive,finalHasUpper,finalUpper,finalUpperInclusive,newDescending);
        }

        //1
        public MyTreeSet()
        {
            m = new MyTreeMap<E, object>();
            hasLowerBound = false;
            hasUpperBound = false;
            descending = false;
        }

        //2
        public MyTreeSet(MyTreeMap<E, object> m)
        {
            if (m == null)
            {
                throw new ArgumentNullException("m");
            }

            this.m = m;
            hasLowerBound = false;
            hasUpperBound = false;
            descending = false;
        }

        //3
        public MyTreeSet(TreeMapComparator<E> comparator)
        {
            if (comparator == null)
            {
                throw new ArgumentNullException("comparator");
            }

            m = new MyTreeMap<E, object>(comparator);
            hasLowerBound = false;
            hasUpperBound = false;
            descending = false;
        }

        //4
        public MyTreeSet(E[] a)
        {
            if (a == null)
            {
                throw new ArgumentNullException("a");
            }

            m = new MyTreeMap<E, object>();
            hasLowerBound = false;
            hasUpperBound = false;
            descending = false;

            addAll(a);
        }

        //5
        public MyTreeSet(SortedSet<E> s)
        {
            if (s == null)
            {
                throw new ArgumentNullException("s");
            }

            m = new MyTreeMap<E, object>(s.Comparer);
            hasLowerBound = false;
            hasUpperBound = false;
            descending = false;

            foreach (E item in s)
            {
                add(item);
            }
        }

        //6
        public bool add(E e)
        {
            CheckNull(e);
            CheckRangeForAdd(e);
            return m.Put(e, PRESENT);
        }

        //7
        public bool addAll(E[] a)
        {
            if (a == null)
            {
                throw new ArgumentNullException("a");
            }

            bool changed = false;

            for (int i = 0; i < a.Length; i++)
            {
                if (add(a[i]))
                {
                    changed = true;
                }
            }

            return changed;
        }

        //8
        public void clear()
        {
            if (!hasLowerBound && !hasUpperBound)
            {
                m.Clear();
                return;
            }

            List<E> list = new List<E>();

            foreach (E item in EnumerateVisibleAscending())
            {
                list.Add(item);
            }

            for (int i = 0; i < list.Count; i++)
            {
                m.Remove(list[i]);
            }
        }

        //9
        public bool contains(object o)
        {
            if (!(o is E))
            {
                return false;
            }

            E value = (E)o;

            if (!InRange(value))
            {
                return false;
            }

            return m.ContainsKey(value);
        }

        //10
        public bool containsAll(E[] a)
        {
            if (a == null)
            {
                throw new ArgumentNullException("a");
            }

            for (int i = 0; i < a.Length; i++)
            {
                if (!contains(a[i]))
                {
                    return false;
                }
            }

            return true;
        }

        //11
        public bool isEmpty()
        {
            E value;
            return !TryGetFirstVisible(out value);
        }

        //12
        public bool remove(object o)
        {
            if (!(o is E))
            {
                return false;
            }

            E value = (E)o;

            if (!InRange(value))
            {
                return false;
            }

            return m.Remove(value);
        }

        //13
        public bool removeAll(E[] a)
        {
            if (a == null)
            {
                throw new ArgumentNullException("a");
            }

            bool changed = false;

            for (int i = 0; i < a.Length; i++)
            {
                if (remove(a[i]))
                {
                    changed = true;
                }
            }

            return changed;
        }

        //14
        public bool retainAll(E[] a)
        {
            if (a == null)
            {
                throw new ArgumentNullException("a");
            }

            List<E> list = new List<E>();

            foreach (E item in EnumerateVisibleAscending())
            {
                if (!ContainsInArray(item, a))
                {
                    list.Add(item);
                }
            }

            bool changed = false;

