        //23
        public E ceiling(E obj)
        {
            CheckNull(obj);

            E value;
            bool ok;

            if (hasLowerBound)
            {
                int cmp = m.CompareKeys(obj, lowerBound);

                if (cmp < 0)
                {
                    if (lowerInclusive)
                    {
                        ok = m.TryGetCeilingKey(lowerBound, out value);
                    }
                    else
                    {
                        ok = m.TryGetHigherKey(lowerBound, out value);
                    }
                }
                else if (cmp == 0 && !lowerInclusive)
                {
                    ok = m.TryGetHigherKey(lowerBound, out value);
                }
                else
                {
                    ok = m.TryGetCeilingKey(obj, out value);
                }
            }
            else
            {
                ok = m.TryGetCeilingKey(obj, out value);
            }

            if (!ok || !InRange(value))
            {
                return default(E);
            }

            return value;
        }

