        static void Task23(MyHashMap<string, VariableInfo> map)
        {
            string text = File.ReadAllText("/Users/m/Documents/JetBrains Rider/c#/MyHashMap/MyHashMap/input23.txt");

            Regex regex = new Regex(@"([A-Za-z][A-Za-z0-9_]*)\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([0-9]+)\s*;");

            MatchCollection matches = regex.Matches(text);

            List<string> textUnknown = new List<string>();

            for (int i = 0; i < matches.Count; i++)
            {
                string typeText = matches[i].Groups[1].Value;
                string name = matches[i].Groups[2].Value;
                string value = matches[i].Groups[3].Value;

                VariableType type;

                if (typeText == "int")
                {
                    type = VariableType.Int;
                }
                else if (typeText == "float")
                {
                    type = VariableType.Float;
                }
                else if (typeText == "double")
                {
                    type = VariableType.Double;
                }
                else
                {
                    Console.WriteLine("Неизвестный тип " + typeText + " у переменной " + name);
                    textUnknown.Add(typeText + " " + name + " => " + value);
                    continue;
                }

                if (map.containsKey(name))
                {
                    Console.WriteLine("Переопределение переменной: " + name);
                    continue;
                }

                VariableInfo info = new VariableInfo(type, value);
                map.Put(name, info);
            }

            MyHashMap<string, VariableInfo>.Entry[] entries = map.entrySet();

            string result = "";

            for (int i = 0; i < entries.Length; i++)
            {
                string typeText = "";

                if (entries[i].Value.Type == VariableType.Int)
                {
                    typeText = "int";
                }
                else if (entries[i].Value.Type == VariableType.Float)
                {
                    typeText = "float";
                }
                else if (entries[i].Value.Type == VariableType.Double)
                {
                    typeText = "double";
                }

                result += typeText + " => " + entries[i].Key + "(" + entries[i].Value.Value + ")\n";
            }

            result += "\n";
            result += "Все неизвестные переменные:\n";

            for (int i = 0; i < textUnknown.Count; i++)
            {
                result += textUnknown[i] + "\n";
            }

            File.WriteAllText("/Users/m/Documents/JetBrains Rider/c#/MyHashMap/MyHashMap/output23.txt", result);
        }

        
